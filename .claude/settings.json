{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/require-docs-before-commit.sh\" || true",
            "timeout": 10,
            "statusMessage": "Checking living docs are updated before commit…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/gloss-variables-reminder.sh\" || true",
            "timeout": 5,
            "suppressOutput": true
          }
        ]
      }
    ]
  }
}

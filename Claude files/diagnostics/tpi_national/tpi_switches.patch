+def _float_shift(v, cal):
+    # EXPERIMENT: DEFAULT RISK FALLS WITH THE PRIVATE FLOAT (COSTAIN-NUNO-THOMAS); phi = 0 NESTS.
+    phi = cal.get("phi_float", 0.0)
+    if phi == 0.0:
+        return 0.0
+    share = _smax(1.0 - v.M_cb_new / max(v.Bp_D, 1e-6), 0.05, 1e-3)
+    return phi * np.log(share)

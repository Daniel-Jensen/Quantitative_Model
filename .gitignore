# macOS Finder metadata
.DS_Store

# Python bytecode cache
__pycache__/
*.pyc

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Claude Code local tool config/runtime state. The doc-sync gate and the
# settings that install it are TRACKED deliberately (CLAUDE.md "Typical
# iteration" step 6 relies on them), so they are exempted below.
.claude/
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**

# Bocola (2016) replication package: the author's solved-model .mat outputs
# (165 MB; counterfactual.mat alone is 113 MB, over GitHub's 100 MB file
# limit). Regenerate them with the package's own Model/*.m scripts.
replication/bocola2016/Matfiles/

# run.py's results (results/<MODEL>/data, figures, run.log) -- regenerated by the
# pipeline on every run (see Claude files/docs/STATE.md "Next priorities": figures must be regenerated
# after any calibration change, so a committed copy goes stale immediately). outputs/ is
# the pre-2026-09-30 location of the same artefacts.
results/
outputs/
